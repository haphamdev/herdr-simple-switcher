# Copy this file to the plugin config dir as `config.env`:
#   cp config.example.env "$(herdr plugin config-dir simple-switcher)/config.env"
#
# Root directory that holds your projects, laid out as <workspace>/<project>.
# A leading ~ and $HOME are expanded. Overridable at runtime with
# HERDR_SIMPLE_SWITCHER_PROJECTS_ROOT.
PROJECTS_ROOT="$HOME/projects"
